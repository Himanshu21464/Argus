# Argus — HTTP headers for Netlify / Cloudflare Pages / Vercel.
#
# Defense in depth: index.html also carries `<meta http-equiv>`
# security tags. HTTP headers are stronger (CSP enforcement applies
# to ALL responses, not just top-level navigations; X-Frame-Options
# and HSTS only exist as headers). The meta tags protect offline /
# local previews and double-check the deployment.
#
# Test with: curl -I https://your-deploy.example/

/*
  # ── HSTS — pairs with upgrade-insecure-requests in the CSP.
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # ── Strict CSP.
  #   default-src 'self'                              same-origin only by default
  #   script-src   'self' cdnjs 'inline-speculation-rules'
  #     ↳ Three.js is pinned by SRI (sha384) on the <script> tag, so a
  #       cdnjs compromise can't substitute a malicious script.
  #     ↳ inline-speculation-rules keeps any <script type="speculation
  #       rules"> tags working under strict CSP3.
  #   style-src    'self' 'unsafe-inline' fonts.googleapis.com
  #     ↳ Google Fonts CSS is dynamic per UA; SRI is not stable.
  #     ↳ 'unsafe-inline' covers the one inline <style> in noscript and
  #       the single inline style= attribute. Accepted residual.
  #   font-src     'self' fonts.gstatic.com
  #   img-src      'self' data:                       no remote pixels
  #   connect-src  'self'                             fetch only same-origin
  #   media-src    'self'
  #   object-src   'none'                             kill Flash/plugin XSS
  #   manifest-src 'self'
  #   worker-src   'self'
  #   base-uri     'self'                             no <base href=…> injection
  #   form-action  'self'                             no exfil POSTs
  #   frame-ancestors 'none'                          clickjacking
  #   upgrade-insecure-requests                       force http:// → https://
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com 'inline-speculation-rules'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

  # ── Headers that can't be set via <meta http-equiv>.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), bluetooth=(), serial=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=(), midi=(), autoplay=(), picture-in-picture=(), encrypted-media=(), fullscreen=(self), web-share=(self), idle-detection=(), screen-wake-lock=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless
  X-Robots-Tag: index, follow

  # ── Stop UA hint leaks; static docs don't need them.
  Accept-CH: ""

# ── HTML: short-lived, SWR.
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# ── CSS / JS: longer cache, query-string versioned (argus.css?v=17 etc.)
/argus.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
